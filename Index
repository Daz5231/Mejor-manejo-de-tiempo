<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Hora de Estudio</title>
<style>
/* ===== Tokens (claro / oscuro) ===== */
:root{--bg:#F2F5FA;--card:#fff;--ink:#14213D;--mute:#5B6785;--line:#D9E0EE;--acc:#2447E0;--acc-ink:#fff;--hl:#FFD23F;--ok:#16794C;--bad:#B3261E;--r:14px;
--serif:Georgia,"Times New Roman",serif;--sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
:root[data-theme=dark]{--bg:#0F1524;--card:#18203A;--ink:#EAF0FF;--mute:#9AA7C7;--line:#2B3556;--acc:#7C97FF;--acc-ink:#0F1524;--ok:#5ED39A;--bad:#FF8A80}
@media(prefers-color-scheme:dark){:root[data-theme=auto]{--bg:#0F1524;--card:#18203A;--ink:#EAF0FF;--mute:#9AA7C7;--line:#2B3556;--acc:#7C97FF;--acc-ink:#0F1524;--ok:#5ED39A;--bad:#FF8A80}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 var(--sans);padding:env(safe-area-inset-top) 0 calc(76px + env(safe-area-inset-bottom))}
h1,h2{font-family:var(--serif);margin:0;letter-spacing:-.01em}
h1{font-size:1.5rem}h2{font-size:1.25rem;margin-bottom:.6rem}
header{display:flex;align-items:center;justify-content:space-between;gap:.5rem;max-width:860px;margin:0 auto;padding:1rem}
h1 mark{background:linear-gradient(transparent 55%,var(--hl) 55%);color:inherit}
main{max-width:860px;margin:0 auto;padding:0 1rem}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:1rem;margin-bottom:1rem}
button,input,select{font:inherit;color:inherit}
button{min-height:44px;padding:.5rem 1rem;border-radius:10px;border:1px solid var(--line);background:var(--card);cursor:pointer}
button.p{background:var(--acc);color:var(--acc-ink);border-color:var(--acc);font-weight:600}
button.d{color:var(--bad)}
button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--hl);outline-offset:2px}
input,select{min-height:44px;padding:.4rem .7rem;border-radius:10px;border:1px solid var(--line);background:var(--bg);width:100%}
label{display:block;font-size:.85rem;color:var(--mute);margin-bottom:.2rem}
.grid{display:grid;gap:.7rem;grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
.row{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center}
.chk{display:flex;align-items:center;gap:.5rem;min-height:44px;color:var(--ink);font-size:1rem}
.chk input{width:22px;min-height:22px;height:22px}
/* Navegación: abajo en móvil, arriba en escritorio */
nav{position:fixed;bottom:0;left:0;right:0;display:flex;background:var(--card);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom);z-index:5}
nav button{flex:1;border:0;border-radius:0;background:none;min-height:60px;font-size:.85rem;color:var(--mute)}
nav button[aria-selected=true]{color:var(--acc);font-weight:700;box-shadow:inset 0 3px var(--acc)}
@media(min-width:760px){nav{position:static;max-width:860px;margin:0 auto 1rem;border:1px solid var(--line);border-radius:var(--r);overflow:hidden}body{padding-bottom:2rem}nav button{min-height:48px;font-size:1rem}}
section[hidden]{display:none}
/* Tareas */
.t{display:flex;gap:.7rem;align-items:flex-start;padding:.7rem 0;border-top:1px solid var(--line)}
.t:first-child{border-top:0}
.t input[type=checkbox]{width:24px;min-height:24px;height:24px;margin-top:.15rem}
.t .b{flex:1;min-width:0}.t .n{font-weight:600;overflow-wrap:anywhere}
.t.done .n{text-decoration:line-through;color:var(--mute)}
.meta{font-size:.85rem;color:var(--mute)}
.pr{display:inline-block;width:.6rem;height:.6rem;border-radius:50%;margin-right:.3rem}
.pr.alta{background:var(--bad)}.pr.media{background:var(--hl)}.pr.baja{background:var(--ok)}
.late{color:var(--bad);font-weight:600}
.empty{text-align:center;color:var(--mute);padding:1.5rem .5rem}
.seg{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:.7rem}
.seg button[aria-pressed=true]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
/* Temporizadores */
.clock{text-align:center}
.ring{position:relative;width:min(70vw,260px);margin:.5rem auto}
.ring svg{width:100%;transform:rotate(-90deg)}
.ring .tx{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.big{font:700 clamp(2.4rem,12vw,3.4rem)/1 var(--serif);font-variant-numeric:tabular-nums}
.pill{display:inline-block;padding:.15rem .7rem;border-radius:99px;background:var(--hl);color:#14213D;font-weight:600;font-size:.85rem}
.status{display:inline-block;padding:.25rem .7rem;border-radius:99px;border:1px solid var(--line);font-size:.9rem}
.status.on{color:var(--ok);border-color:var(--ok)}.status.off{color:var(--bad);border-color:var(--bad)}
/* Toasts */
#toasts{position:fixed;top:calc(.7rem + env(safe-area-inset-top));left:.7rem;right:.7rem;display:flex;flex-direction:column;gap:.5rem;align-items:center;z-index:20;pointer-events:none}
.toast{pointer-events:auto;max-width:460px;width:100%;background:var(--ink);color:var(--bg);padding:.8rem 1rem;border-radius:12px;box-shadow:0 6px 24px #0004;display:flex;gap:.7rem;justify-content:space-between;align-items:center}
.toast button{min-height:32px;padding:.1rem .6rem;background:none;color:inherit;border-color:currentColor}
@media(prefers-reduced-motion:no-preference){.toast{animation:in .25s ease-out}@keyframes in{from{transform:translateY(-12px);opacity:0}}}
</style>
</head>
<body>
<header>
  <h1><mark>Hora</mark> de estudio</h1>
  <button id="themeBtn" aria-label="Cambiar tema claro u oscuro">Tema</button>
</header>
<div id="toasts" role="status" aria-live="polite"></div>

<main>
<nav role="tablist" aria-label="Herramientas">
  <button role="tab" data-tab="agenda" aria-selected="true">📅 Agenda</button>
  <button role="tab" data-tab="pomo" aria-selected="false">🍅 Pomodoro</button>
  <button role="tab" data-tab="box" aria-selected="false">⏳ Bloques</button>
  <button role="tab" data-tab="set" aria-selected="false">⚙️ Ajustes</button>
</nav>

<!-- ===== AGENDA ===== -->
<section id="agenda">
  <form class="card" id="taskForm">
    <h2>Nueva tarea o bloque</h2>
    <div class="grid">
      <div><label for="tTitle">¿Qué tienes que hacer?</label><input id="tTitle" required maxlength="80" placeholder="Ej. Entregar ensayo de Historia"></div>
      <div><label for="tSub">Materia</label><input id="tSub" maxlength="40" placeholder="Ej. Historia"></div>
      <div><label for="tWhen">Fecha y hora (opcional)</label><input id="tWhen" type="datetime-local"></div>
      <div><label for="tDur">Duración en min (opcional)</label><input id="tDur" type="number" min="5" max="600" step="5" placeholder="60"></div>
      <div><label for="tPri">Prioridad</label><select id="tPri"><option value="alta">Alta</option><option value="media" selected>Media</option><option value="baja">Baja</option></select></div>
    </div>
    <label class="chk"><input type="checkbox" id="tRem" checked> Avisarme 10 min y 5 min antes, y al llegar la hora</label>
    <button class="p" type="submit">Agregar a mi agenda</button>
  </form>
  <div class="card">
    <div class="seg" id="filters" role="group" aria-label="Filtrar tareas">
      <button data-f="hoy" aria-pressed="true">Hoy</button><button data-f="prox" aria-pressed="false">Próximas</button>
      <button data-f="todas" aria-pressed="false">Todas</button><button data-f="hechas" aria-pressed="false">Hechas</button>
    </div>
    <div id="taskList"></div>
  </div>
</section>

<!-- ===== POMODORO ===== -->
<section id="pomo" hidden>
  <div class="card clock">
    <span class="pill" id="pMode">Enfoque</span>
    <div class="ring"><svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="45" fill="none" stroke="var(--line)" stroke-width="6"/><circle id="pArc" cx="50" cy="50" r="45" fill="none" stroke="var(--acc)" stroke-width="6" stroke-linecap="round" stroke-dasharray="282.7" stroke-dashoffset="0"/></svg>
      <div class="tx"><div class="big" id="pTime">25:00</div><div class="meta" id="pCycles"></div></div></div>
    <div class="row" style="justify-content:center">
      <button class="p" id="pGo">Iniciar</button><button id="pReset">Reiniciar</button><button id="pSkip">Saltar etapa</button>
    </div>
  </div>
  <div class="card"><h2>Tiempos (minutos)</h2>
    <div class="grid">
      <div><label for="pF">Enfoque</label><input id="pF" type="number" min="1" max="120"></div>
      <div><label for="pS">Descanso corto</label><input id="pS" type="number" min="1" max="60"></div>
      <div><label for="pL">Descanso largo</label><input id="pL" type="number" min="1" max="90"></div>
      <div><label for="pE">Largo cada (ciclos)</label><input id="pE" type="number" min="2" max="10"></div>
    </div>
    <label class="chk"><input type="checkbox" id="pW"> Avisar cuando queden 5 min en bloques de enfoque largos</label>
  </div>
</section>

<!-- ===== BLOQUES ===== -->
<section id="box" hidden>
  <div class="card clock">
    <span class="pill">Cuenta regresiva con avisos</span>
    <div class="ring"><svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="45" fill="none" stroke="var(--line)" stroke-width="6"/><circle id="bArc" cx="50" cy="50" r="45" fill="none" stroke="var(--acc)" stroke-width="6" stroke-linecap="round" stroke-dasharray="282.7" stroke-dashoffset="0"/></svg>
      <div class="tx"><div class="big" id="bTime">45:00</div></div></div>
    <p class="meta" id="bNext" style="margin:.2rem 0 1rem"></p>
    <div class="row" style="justify-content:center">
      <button class="p" id="bGo">Iniciar</button><button id="bReset">Reiniciar</button>
    </div>
  </div>
  <div class="card"><h2>Configura tu bloque</h2>
    <div class="seg" id="presets" role="group" aria-label="Duraciones rápidas"></div>
    <div class="grid"><div><label for="bMin">Duración en minutos</label><input id="bMin" type="number" min="1" max="600"></div></div>
    <label class="chk"><input type="checkbox" id="b10"> Avisar cuando queden 10 minutos</label>
    <label class="chk"><input type="checkbox" id="b5"> Avisar cuando queden 5 minutos</label>
    <label class="chk"><input type="checkbox" id="b1"> Avisar cuando quede 1 minuto</label>
    <p class="meta">Siempre te avisamos al terminar. Los avisos que no caben en la duración se omiten.</p>
  </div>
</section>

<!-- ===== AJUSTES ===== -->
<section id="set" hidden>
  <div class="card"><h2>Notificaciones</h2>
    <p><span class="status" id="permSt"></span></p>
    <div class="row"><button class="p" id="permBtn">Activar notificaciones</button><button id="testBtn">Probar notificación</button></div>
    <label class="chk"><input type="checkbox" id="sndChk"> Sonido suave al avisar</label>
    <p class="meta">Si el sistema las bloquea, igual verás avisos dentro de la página. Mantén esta pestaña abierta (puede estar en segundo plano).</p>
  </div>
  <div class="card"><h2>Tus datos</h2>
    <p class="meta">Todo se guarda en este dispositivo. Nada se envía a internet.</p>
    <div class="row"><button id="expBtn">Exportar respaldo</button><button id="demoBtn">Cargar ejemplos</button><button class="d" id="clrBtn">Borrar todo</button></div>
  </div>
</section>
</main>

<script>
"use strict";
/* ========== 1. ESTADO Y PERSISTENCIA ========== */
const KEY = "horaEstudio.v1";
const DEF = () => ({
  tasks: [], fired: {},
  pomo: { focus: 25, short: 5, long: 15, every: 4, warn: true, mode: "focus", cycles: 0, endAt: null, left: null, w5: false },
  box: { min: 45, w10: true, w5: true, w1: false, endAt: null, left: null, fired: [] },
  prefs: { sound: true, theme: "auto" }
});
let S;
try { S = Object.assign(DEF(), JSON.parse(localStorage.getItem(KEY) || "{}")); } catch { S = DEF(); }
const save = () => { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch {} };
const $ = id => document.getElementById(id);
const pad = n => String(n).padStart(2, "0");
const fmt = ms => { const s = Math.max(0, Math.ceil(ms / 1000)); return pad(Math.floor(s / 60)) + ":" + pad(s % 60); };

/* ========== 2. AVISOS (toast + sonido + Notification API) ========== */
let actx;
function beep() {
  if (!S.prefs.sound) return;
  try {
    actx = actx || new (window.AudioContext || window.webkitAudioContext)();
    if (actx.state === "suspended") actx.resume();
    [660, 880].forEach((f, i) => {            // dos notas suaves
      const o = actx.createOscillator(), g = actx.createGain(), t = actx.currentTime + i * 0.22;
      o.frequency.value = f; o.type = "sine"; o.connect(g); g.connect(actx.destination);
      g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(0.18, t + 0.03); g.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
      o.start(t); o.stop(t + 0.4);
    });
  } catch {}
}
function toast(title, body) {
  const el = document.createElement("div"); el.className = "toast";
  const tx = document.createElement("div"); tx.innerHTML = "<strong></strong><div class='meta' style='color:inherit;opacity:.8'></div>";
  tx.firstChild.textContent = title; tx.lastChild.textContent = body || "";
  const x = document.createElement("button"); x.textContent = "Cerrar"; x.onclick = () => el.remove();
  el.append(tx, x); $("toasts").append(el); setTimeout(() => el.remove(), 12000);
}
function notify(title, body) {
  toast(title, body); beep();
  if ("Notification" in window && Notification.permission === "granted") {
    try { new Notification(title, { body, tag: title + body, icon: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10'%3E%3Ctext y='8' font-size='8'%3E⏰%3C/text%3E%3C/svg%3E" }); }
    catch { /* Android Chrome exige Service Worker: queda el toast */ }
  }
  if (navigator.vibrate) navigator.vibrate([150, 80, 150]);
}
function renderPerm() {
  const st = $("permSt"), b = $("permBtn");
  const p = "Notification" in window ? Notification.permission : "nosoporte";
  const map = { granted: ["Notificaciones activadas", "on"], denied: ["Bloqueadas en el navegador", "off"], default: ["Pendientes de activar", ""], nosoporte: ["Este navegador no las soporta", "off"] };
  st.textContent = map[p][0]; st.className = "status " + map[p][1];
  b.hidden = p === "granted" || p === "nosoporte";
  b.textContent = p === "denied" ? "Cómo desbloquear" : "Activar notificaciones";
}
$("permBtn").onclick = async () => {
  if (Notification.permission === "denied") return toast("Desbloquea los permisos", "Toca el candado junto a la dirección → Notificaciones → Permitir, y recarga.");
  try { await Notification.requestPermission(); } catch {}
  renderPerm();
};
$("testBtn").onclick = () => notify("Notificación de prueba", "Si ves y oyes esto, los avisos funcionan.");

/* ========== 3. NAVEGACIÓN Y TEMA ========== */
document.querySelectorAll("nav button").forEach(b => b.onclick = () => {
  document.querySelectorAll("nav button").forEach(x => x.setAttribute("aria-selected", x === b));
  ["agenda", "pomo", "box", "set"].forEach(id => $(id).hidden = id !== b.dataset.tab);
});
const applyTheme = () => document.documentElement.dataset.theme = S.prefs.theme;
$("themeBtn").onclick = () => { const o = ["auto", "light", "dark"]; S.prefs.theme = o[(o.indexOf(S.prefs.theme) + 1) % 3]; applyTheme(); save(); toast("Tema: " + { auto: "automático", light: "claro", dark: "oscuro" }[S.prefs.theme]); };

/* ========== 4. AGENDA ========== */
let filter = "hoy";
const dueOf = t => t.when ? new Date(t.when).getTime() : null;
$("taskForm").onsubmit = e => {
  e.preventDefault();
  S.tasks.push({ id: Date.now(), title: $("tTitle").value.trim(), sub: $("tSub").value.trim(), when: $("tWhen").value, dur: +$("tDur").value || 0, pri: $("tPri").value, rem: $("tRem").checked, done: false });
  e.target.reset(); $("tRem").checked = true; save(); renderTasks(); $("tTitle").focus();
};
document.querySelectorAll("#filters button").forEach(b => b.onclick = () => {
  filter = b.dataset.f; document.querySelectorAll("#filters button").forEach(x => x.setAttribute("aria-pressed", x === b)); renderTasks();
});
function renderTasks() {
  const now = new Date(), d0 = new Date(now).setHours(0, 0, 0, 0), d1 = d0 + 864e5;
  const f = { hoy: t => !t.done && (!t.when || dueOf(t) < d1), prox: t => !t.done && t.when && dueOf(t) >= d1, todas: t => !t.done, hechas: t => t.done }[filter];
  const list = S.tasks.filter(f).sort((a, b) => (dueOf(a) ?? 9e15) - (dueOf(b) ?? 9e15));
  const box = $("taskList"); box.innerHTML = "";
  if (!list.length) {
    box.innerHTML = "<div class='empty'></div>";
    box.firstChild.textContent = { hoy: "Nada pendiente para hoy. Agrega tu primera tarea arriba y te avisamos antes de que llegue.", prox: "No tienes tareas futuras. Planear con tiempo es la mitad del trabajo.", todas: "Tu agenda está vacía. Empieza con algo pequeño: tu próxima clase o entrega.", hechas: "Aún no has completado tareas. ¡Marca la primera!" }[filter];
    return;
  }
  list.forEach(t => {
    const el = document.createElement("div"); el.className = "t" + (t.done ? " done" : "");
    const cb = document.createElement("input"); cb.type = "checkbox"; cb.checked = t.done; cb.setAttribute("aria-label", "Completar " + t.title);
    cb.onchange = () => { t.done = cb.checked; save(); renderTasks(); };
    const b = document.createElement("div"); b.className = "b";
    const n = document.createElement("div"); n.className = "n"; n.textContent = t.title;
    const m = document.createElement("div"); m.className = "meta";
    const late = !t.done && t.when && dueOf(t) < Date.now();
    const when = t.when ? new Date(t.when).toLocaleString("es", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }) : "Sin hora";
    m.innerHTML = "<span class='pr " + t.pri + "'></span>";
    m.append([t.sub, when, t.dur ? t.dur + " min" : "", t.rem && t.when ? "🔔" : ""].filter(Boolean).join(" · "));
    if (late) { const l = document.createElement("span"); l.className = "late"; l.textContent = " · Vencida"; m.append(l); }
    b.append(n, m);
    const del = document.createElement("button"); del.className = "d"; del.textContent = "Quitar"; del.setAttribute("aria-label", "Quitar " + t.title);
    del.onclick = () => { S.tasks = S.tasks.filter(x => x !== t); save(); renderTasks(); };
    el.append(cb, b, del); box.append(el);
  });
}
/* Avisos de agenda: 10 min, 5 min y hora exacta. Solo dispara el más reciente ya cruzado. */
function taskTick() {
  const now = Date.now();
  S.tasks.forEach(t => {
    if (t.done || !t.rem || !t.when) return;
    const due = dueOf(t), crossed = [10, 5, 0].filter(m => now >= due - m * 6e4 && !S.fired[t.id + ":" + m]);
    if (!crossed.length) return;
    crossed.forEach(m => S.fired[t.id + ":" + m] = 1); save();
    const m = Math.min(...crossed);
    if (now - (due - m * 6e4) > 3e5) return;       // aviso viejo (ej. al reabrir): se ignora
    notify(m ? `Te quedan ${m} minutos` : "¡Es la hora!", t.title + (t.sub ? " · " + t.sub : ""));
  });
}

/* ========== 5. POMODORO (basado en Date.now) ========== */
const P = S.pomo, NAMES = { focus: "Enfoque", short: "Descanso corto", long: "Descanso largo" };
const pDur = () => P[P.mode] * 6e4;
const pLeft = () => P.endAt ? P.endAt - Date.now() : (P.left ?? pDur());
function pNext() {
  if (P.mode === "focus") { P.cycles++; P.mode = P.cycles % P.every === 0 ? "long" : "short"; } else P.mode = "focus";
  P.endAt = P.left = null; P.w5 = false;
}
$("pGo").onclick = () => {
  if (P.endAt) { P.left = P.endAt - Date.now(); P.endAt = null; }          // pausar
  else { P.endAt = Date.now() + pLeft(); P.left = null; beep && actx === undefined && beep(); }   // iniciar/reanudar
  save(); renderPomo();
};
$("pReset").onclick = () => { P.endAt = P.left = null; P.w5 = false; save(); renderPomo(); };
$("pSkip").onclick = () => { pNext(); save(); renderPomo(); };
function pomoTick() {
  if (!P.endAt) return;
  const l = P.endAt - Date.now();
  if (P.warn && P.mode === "focus" && !P.w5 && pDur() >= 10 * 6e4 && l <= 5 * 6e4 && l > 0) { P.w5 = true; save(); notify("Te quedan 5 minutos", "Ve cerrando lo que estás haciendo."); }
  if (l <= 0) {
    const was = P.mode; pNext(); save();
    notify(was === "focus" ? "¡Enfoque completado!" : "Fin del descanso", was === "focus" ? "Toca " + NAMES[P.mode].toLowerCase() + ". Inícialo cuando estés listo." : "¿Listo para otro bloque de enfoque?");
  }
}
function renderPomo() {
  const l = pLeft();
  $("pTime").textContent = fmt(l); $("pMode").textContent = NAMES[P.mode];
  $("pCycles").textContent = P.cycles + " ciclos completados";
  $("pGo").textContent = P.endAt ? "Pausar" : (P.left != null ? "Reanudar" : "Iniciar");
  $("pArc").style.strokeDashoffset = 282.7 * (1 - Math.max(0, l) / pDur());
}
[["pF", "focus"], ["pS", "short"], ["pL", "long"], ["pE", "every"]].forEach(([id, k]) => {
  $(id).value = P[k];
  $(id).onchange = () => { P[k] = Math.max(1, +$(id).value || P[k]); $(id).value = P[k]; if (!P.endAt) P.left = null; save(); renderPomo(); };
});
$("pW").checked = P.warn; $("pW").onchange = () => { P.warn = $("pW").checked; save(); };

/* ========== 6. BLOQUES CON AVISOS PROGRESIVOS ========== */
const B = S.box, TH = () => [[10, B.w10], [5, B.w5], [1, B.w1]].filter(x => x[1] && x[0] * 6e4 < B.min * 6e4).map(x => x[0]);
const bLeft = () => B.endAt ? B.endAt - Date.now() : (B.left ?? B.min * 6e4);
$("bGo").onclick = () => {
  if (B.endAt) { B.left = B.endAt - Date.now(); B.endAt = null; }
  else { if (B.left == null) B.fired = []; B.endAt = Date.now() + bLeft(); B.left = null; }
  save(); renderBox();
};
$("bReset").onclick = () => { B.endAt = B.left = null; B.fired = []; save(); renderBox(); };
function boxTick() {
  if (!B.endAt) return;
  const l = B.endAt - Date.now();
  const due = TH().filter(m => l <= m * 6e4 && !B.fired.includes(m));
  if (due.length) { B.fired.push(...due); save(); const m = Math.min(...due); if (l > 0) notify(`Te quedan ${m} minuto${m > 1 ? "s" : ""}`, "Tu bloque de estudio está por terminar."); }
  if (l <= 0) { B.endAt = B.left = null; B.fired = []; save(); notify("¡Tiempo terminado!", "Tu bloque de " + B.min + " min acabó."); }
}
function renderBox() {
  const l = bLeft(), total = B.min * 6e4;
  $("bTime").textContent = fmt(l);
  $("bArc").style.strokeDashoffset = 282.7 * (1 - Math.max(0, l) / total);
  $("bGo").textContent = B.endAt ? "Pausar" : (B.left != null ? "Reanudar" : "Iniciar");
  const nxt = TH().filter(m => m * 6e4 < l - 500 && !B.fired.includes(m))[0];
  $("bNext").textContent = nxt ? `Próximo aviso: cuando queden ${nxt} min (en ${fmt(l - nxt * 6e4)})` : "Próximo aviso: al terminar";
}
[[10, "b10"], [5, "b5"], [1, "b1"]].forEach(([m, id]) => { $(id).checked = B["w" + m]; $(id).onchange = () => { B["w" + m] = $(id).checked; save(); renderBox(); }; });
$("bMin").value = B.min;
$("bMin").onchange = () => { B.min = Math.max(1, +$("bMin").value || 45); B.endAt = B.left = null; B.fired = []; save(); renderBox(); };
[15, 25, 45, 60, 90].forEach(m => {
  const b = document.createElement("button"); b.textContent = m + " min";
  b.onclick = () => { $("bMin").value = m; $("bMin").onchange(); }; $("presets").append(b);
});

/* ========== 7. AJUSTES / DATOS ========== */
$("sndChk").checked = S.prefs.sound; $("sndChk").onchange = () => { S.prefs.sound = $("sndChk").checked; save(); if (S.prefs.sound) beep(); };
$("expBtn").onclick = () => {
  const a = document.createElement("a"); a.href = URL.createObjectURL(new Blob([JSON.stringify(S, null, 2)], { type: "application/json" }));
  a.download = "hora-de-estudio-respaldo.json"; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
};
$("demoBtn").onclick = () => {
  const at = m => { const d = new Date(Date.now() + m * 6e4 - new Date().getTimezoneOffset() * 6e4); return d.toISOString().slice(0, 16); };
  S.tasks.push({ id: Date.now(), title: "Ejemplo: repasar apuntes", sub: "Demo", when: at(11), dur: 30, pri: "alta", rem: true, done: false },
               { id: Date.now() + 1, title: "Ejemplo: leer capítulo 3", sub: "Demo", when: at(60 * 26), dur: 45, pri: "media", rem: true, done: false });
  save(); renderTasks(); toast("Ejemplos cargados", "El primero te avisará en 1 minuto (faltarán 10).");
};
$("clrBtn").onclick = () => { if (confirm("¿Borrar tareas, ciclos y ajustes de este dispositivo?")) { localStorage.removeItem(KEY); location.reload(); } };

/* ========== 8. BUCLE PRINCIPAL ========== */
function tick() {
  taskTick(); pomoTick(); boxTick(); renderPomo(); renderBox();
  document.title = P.endAt ? fmt(pLeft()) + " · " + NAMES[P.mode] : B.endAt ? fmt(bLeft()) + " · Bloque" : "Hora de estudio";
}
document.addEventListener("visibilitychange", tick);           // recalcula al volver a la pestaña
document.addEventListener("click", () => { try { actx = actx || new (window.AudioContext || window.webkitAudioContext)(); actx.resume(); } catch {} }, { once: true });
applyTheme(); renderPerm(); renderTasks(); tick();
setInterval(tick, 1000);                                        // solo "despierta"; el tiempo real sale de Date.now()
setInterval(renderTasks, 60000);
</script>
</body>
</html>
